; Generated by Frappe Docker Manager UI - Frappe processes for {{ domain }}
[group:frappe]
programs={{ programs | map(attribute="name") | join(",") }}
{% for p in programs %}
[program:{{ p.name }}]
command={{ p.command }}
directory=/home/frappe/frappe-bench
user=frappe
autostart=true
autorestart=true
startsecs=5
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/home/frappe/supervisor/logs/{{ p.name }}.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=3
{% endfor %}
