# Generated by Frappe Docker Manager UI for {{ domain }} - edits are kept until the site is re-generated.
# 4 containers: app (all Frappe processes under Supervisor), create-site (one-shot), db (MariaDB), redis.
name: {{ project }}

x-frappe-env: &frappe-env
  DB_HOST: db
  DB_PORT: "3306"
  REDIS_HOST: redis
  REDIS_PORT: "6379"
  SOCKETIO_PORT: "9000"
  DB_PASSWORD: ${DB_PASSWORD}
  REDIS_PASSWORD: ${REDIS_PASSWORD}
  ADMIN_PASSWORD: ${ADMIN_PASSWORD}
  FRAPPE_SITE_NAME_HEADER: ${FRAPPE_SITE_NAME_HEADER}
  SITES: ${SITES}
  BACKEND: 127.0.0.1:8000
  SOCKETIO: 127.0.0.1:9000
  NGINX_LISTEN_PORT: "8080"
  TRUST_UPSTREAM_FORWARDED_PROTO: "{{ 'on' if ssl else 'off' }}"

x-frappe-volumes: &frappe-volumes
  - sites:/home/frappe/frappe-bench/sites
  - logs:/home/frappe/frappe-bench/logs
{%- if dev_mount %}
  - {{ apps_dir }}:/home/frappe/frappe-bench/apps
{%- else %}
  - apps:/home/frappe/frappe-bench/apps
{%- endif %}

services:
  app:
    image: frappe/erpnext:${ERPNEXT_VERSION}
    container_name: {{ project }}-app
    restart: unless-stopped
    networks:
      - frappe_network
      - traefik_proxy
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      create-site:
        condition: service_completed_successfully
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=traefik_proxy"
      - "traefik.http.services.{{ project }}-app.loadbalancer.server.port={{ web_port }}"
      - "traefik.http.services.{{ project }}-app.loadbalancer.passHostHeader=true"
      - "traefik.http.services.{{ project }}-ws.loadbalancer.server.port=9000"
      - "traefik.http.routers.{{ project }}-http.rule=Host(`{{ domain }}`)"
      - "traefik.http.routers.{{ project }}-http.entrypoints=web"
      - "traefik.http.routers.{{ project }}-http.service={{ project }}-app"
      - "traefik.http.routers.{{ project }}-ws-http.rule=Host(`{{ domain }}`) && PathPrefix(`/socket.io`)"
      - "traefik.http.routers.{{ project }}-ws-http.entrypoints=web"
      - "traefik.http.routers.{{ project }}-ws-http.service={{ project }}-ws"
{%- if ssl %}
      - "traefik.http.middlewares.{{ project }}-https-redirect.redirectscheme.scheme=https"
      - "traefik.http.middlewares.{{ project }}-https-redirect.redirectscheme.permanent=true"
      - "traefik.http.routers.{{ project }}-http.middlewares={{ project }}-https-redirect"
      - "traefik.http.routers.{{ project }}-ws-http.middlewares={{ project }}-https-redirect"
      - "traefik.http.routers.{{ project }}-https.rule=Host(`{{ domain }}`)"
      - "traefik.http.routers.{{ project }}-https.entrypoints=websecure"
      - "traefik.http.routers.{{ project }}-https.tls=true"
      - "traefik.http.routers.{{ project }}-https.tls.certresolver=le"
      - "traefik.http.routers.{{ project }}-https.service={{ project }}-app"
      - "traefik.http.routers.{{ project }}-ws-https.rule=Host(`{{ domain }}`) && PathPrefix(`/socket.io`)"
      - "traefik.http.routers.{{ project }}-ws-https.entrypoints=websecure"
      - "traefik.http.routers.{{ project }}-ws-https.tls=true"
      - "traefik.http.routers.{{ project }}-ws-https.tls.certresolver=le"
      - "traefik.http.routers.{{ project }}-ws-https.service={{ project }}-ws"
{%- endif %}
    deploy:
      resources:
        limits:
          memory: {{ app_memory }}
          cpus: "{{ app_cpus }}"
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp
      - /var/tmp
    healthcheck:
      # gunicorn picks the site from the Host header, so send it explicitly
      test: ["CMD-SHELL", "curl -fsS -H 'Host: {{ domain }}' http://localhost:{{ web_port }}/api/method/ping >/dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 180s
    volumes:
      - sites:/home/frappe/frappe-bench/sites
      - logs:/home/frappe/frappe-bench/logs
{%- if dev_mount %}
      - {{ apps_dir }}:/home/frappe/frappe-bench/apps
{%- else %}
      - apps:/home/frappe/frappe-bench/apps
{%- endif %}
      - {{ supervisor_dir }}:/home/frappe/supervisor-template:ro
    environment: *frappe-env
    entrypoint:
      - bash
      - -c
      - |
        set -e
        cd /home/frappe/frappe-bench
        echo "🚀 Starting Frappe application container for {{ domain }}"
        if [ -d /home/frappe/frappe-bench/assets ]; then
          # newer images keep built assets outside the sites volume (same as the image's own entrypoint)
          rm -rf sites/assets && ln -s /home/frappe/frappe-bench/assets sites/assets
        fi
        until [ -f "sites/{{ domain }}/site_config.json" ]; do
          echo "⏳ Waiting for site {{ domain }} to be created..."; sleep 5
        done
        if [ ! -x /home/frappe/.local/bin/supervisord ]; then
          echo "📦 Installing supervisor..."
          pip3 install --user --quiet --disable-pip-version-check supervisor
        fi
        mkdir -p /home/frappe/supervisor/conf.d /home/frappe/supervisor/logs
        cp /home/frappe/supervisor-template/supervisord.conf /home/frappe/supervisor/supervisord.conf
        cp /home/frappe/supervisor-template/frappe.conf /home/frappe/supervisor/conf.d/frappe.conf
        rm -f /home/frappe/supervisor/supervisor.sock /home/frappe/supervisor/supervisord.pid
        echo "✅ Starting supervisor (web, scheduler, workers, websocket)"
        exec /home/frappe/.local/bin/supervisord -n -c /home/frappe/supervisor/supervisord.conf

  create-site:
    image: frappe/erpnext:${ERPNEXT_VERSION}
    container_name: {{ project }}-create-site
    restart: "no"
    networks:
      - frappe_network
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp
      - /var/tmp
    volumes: *frappe-volumes
    environment: *frappe-env
    entrypoint:
      - bash
      - -c
      - |
        set -e
        wait-for-it -t 120 db:3306
        wait-for-it -t 120 redis:6379
        cd /home/frappe/frappe-bench
        if [ -d /home/frappe/frappe-bench/assets ]; then
          # newer images keep built assets outside the sites volume (same as the image's own entrypoint)
          rm -rf sites/assets && ln -s /home/frappe/frappe-bench/assets sites/assets
        fi
        ls -1 apps > sites/apps.txt
        echo "⚙️  Writing common_site_config.json"
        bench set-config -g db_host db
        bench set-config -gp db_port 3306
        bench set-config -g redis_cache "redis://:$${REDIS_PASSWORD}@redis:6379"
        bench set-config -g redis_queue "redis://:$${REDIS_PASSWORD}@redis:6379"
        bench set-config -g redis_socketio "redis://:$${REDIS_PASSWORD}@redis:6379"
        bench set-config -gp socketio_port 9000
        if [ ! -d "sites/{{ domain }}" ]; then
          echo "🏗️  Creating site {{ domain }} (this takes a few minutes)..."
          bench new-site "{{ domain }}" \
            --db-root-password "$${DB_PASSWORD}" \
            --admin-password "$${ADMIN_PASSWORD}" \
            --mariadb-user-host-login-scope='%' \
{%- for app in install_apps %}
            --install-app {{ app }} \
{%- endfor %}
            --set-default
{%- if developer_mode %}
          bench --site "{{ domain }}" set-config developer_mode 1
{%- endif %}
          bench --site "{{ domain }}" enable-scheduler || true
        else
          echo "ℹ️  Site {{ domain }} already exists - skipping creation"
        fi
        bench use "{{ domain }}"
        echo "✅ Site {{ domain }} is ready"

  db:
    image: {{ mariadb_image }}
    container_name: {{ project }}-db
    restart: unless-stopped
    networks:
      - frappe_network
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    deploy:
      resources:
        limits:
          memory: 1G
    security_opt:
      - no-new-privileges:true
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --skip-character-set-client-handshake
{%- if mariadb_major >= 11 %}
      # MariaDB 11.8 default; Frappe needs the old behaviour (frappe_docker does the same)
      - --innodb-snapshot-isolation=OFF
{%- else %}
      - --skip-innodb-read-only-compressed
{%- endif %}
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_PASSWORD}
      MARIADB_ROOT_PASSWORD: ${DB_PASSWORD}
      MARIADB_AUTO_UPGRADE: "1"
    volumes:
      - db-data:/var/lib/mysql

  redis:
    image: {{ redis_image }}
    container_name: {{ project }}-redis
    restart: unless-stopped
    networks:
      - frappe_network
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$${REDIS_PASSWORD}\" --no-auth-warning ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    deploy:
      resources:
        limits:
          memory: 512M
    security_opt:
      - no-new-privileges:true
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD}
    command: ["sh", "-c", "exec redis-server --appendonly yes --requirepass \"$${REDIS_PASSWORD}\""]
    volumes:
      - redis-data:/data

networks:
  frappe_network:
    driver: bridge
  traefik_proxy:
    external: true

volumes:
  sites:
  logs:
{%- if not dev_mount %}
  apps:
{%- endif %}
  db-data:
  redis-data:
